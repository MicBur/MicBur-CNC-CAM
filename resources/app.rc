// Windows-Ressourcen: Programmsymbol und Versionsinfo der MicBur-CNC-CAM.exe
IDI_ICON1 ICON "icons/app_icon.ico"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704B0"
        BEGIN
            VALUE "CompanyName", "Michael Burzlaff"
            VALUE "FileDescription", "MicBur-CNC-CAM"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductName", "MicBur-CNC-CAM"
            VALUE "ProductVersion", "1.1.0"
            VALUE "OriginalFilename", "MicBur-CNC-CAM.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0407, 1200
    END
END
